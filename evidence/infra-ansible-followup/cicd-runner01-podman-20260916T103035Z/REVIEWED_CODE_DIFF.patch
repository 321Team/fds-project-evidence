 #!/usr/bin/env python3
 """Check actual container restrictions, then invoke the unchanged pinned kit."""
+import argparse
 import json
 import os
 from pathlib import Path
+import stat
 import subprocess
 import sys
 
 WORK = Path('/work')
 KIT = Path('/kit')
+
+
+def self_test():
+    """Build-time entry readability check; never accesses kit/work or runs Ansible."""
+    entry = Path(__file__)
+    info = entry.stat()
+    checks = dict(uid_gid=(os.getuid() == 1000 and os.getgid() == 1000),
+                  owner=(info.st_uid == 0 and info.st_gid == 0),
+                  mode=(stat.S_IMODE(info.st_mode) == 0o444),
+                  readable=os.access(entry, os.R_OK), writable_absent=not os.access(entry, os.W_OK))
+    passed = all(checks.values())
+    print(json.dumps(dict(check='entry-self-test', passed=passed, checks=checks,
+                         uid=os.getuid(), gid=os.getgid(), owner=[info.st_uid, info.st_gid],
+                         mode=oct(stat.S_IMODE(info.st_mode))), sort_keys=True), flush=True)
+    return 0 if passed else 1
 
 
