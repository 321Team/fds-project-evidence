+def require_container_outputs(rc, state, work, evidence):
+    """Keep the first process failure visible before trying to load result JSON."""
+    expected = ['CONTAINER_RESULT.json', 'ISOLATION.json', 'result/evidence/RUN_RESULT.json']
+    missing = [name for name in expected if not (work / name).is_file() or (work / name).is_symlink()]
+    log = evidence / 'container.log'
+    tail = ''
+    if log.is_file() and not log.is_symlink():
+        with log.open('rb') as handle:
+            handle.seek(max(0, log.stat().st_size - 8192))
+            tail = handle.read(8192).decode('utf-8', errors='replace')
+    diagnostic = dict(podman_rc=rc, exit_code=state.get('ExitCode'), oom_killed=state.get('OOMKilled'),
+                      missing_results=missing, log='container.log', log_tail=tail)
+    write(evidence / 'CONTAINER_DIAGNOSTIC.json', diagnostic)
+    require(type(rc) is int and rc == 0 and type(state.get('ExitCode')) is int
+            and state['ExitCode'] == 0 and state.get('OOMKilled') is False,
+            'Container process failed: podman rc=' + str(rc) + ', ExitCode=' + str(state.get('ExitCode'))
+            + ', OOMKilled=' + str(state.get('OOMKilled')) + '; container.log tail:\n' + tail)
+    require(not missing, 'Container result files missing/linked: ' + ', '.join(missing)
+            + '; container.log tail:\n' + tail)
 
 
