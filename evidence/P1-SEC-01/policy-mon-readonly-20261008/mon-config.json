        "alert-rules-optional.yml": {
          "sha256": "3d2a0baabd2ecddac0d67585bf8910430fc445266b70c2935d4941a4b7739e78",
          "projection": {
            "groups": [
              {
                "name": "fds-optional-hardening",
                "rules": [
                  {
                    "alert": "FDSDetectionBurst",
                    "expr": "sum(increase(fds_detected_total{rule_id=\"R02\"}[5m])) > 20",
                    "for": "1m"
                  },
                  {
                    "alert": "FDSDetectionBurstAnyRule",
                    "expr": "sum by (rule_id) (increase(fds_detected_total[5m])) > 30",
                    "for": "2m"
                  },
                  {
                    "alert": "UnexpectedPodInFdsNs",
                    "expr": "count(\n  kube_pod_info{namespace=\"fds\"}\n  unless on (namespace, pod)\n  kube_pod_labels{namespace=\"fds\", label_app=~\"transaction-api|fds-engine\"}\n) > 0\n",
                    "for": "2m"
                  }
                ]
              }
            ]
          }
        }
      },
