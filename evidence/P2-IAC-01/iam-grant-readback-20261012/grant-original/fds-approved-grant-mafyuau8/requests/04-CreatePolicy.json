{
  "PolicyName": "FDS-IaC-Vpn",
  "Path": "/",
  "PolicyDocument": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ReadSeoulRelayMetadata\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:DescribeImages\",\n        \"ec2:DescribeInstances\",\n        \"ec2:DescribeInstanceAttribute\",\n        \"ec2:DescribeInstanceTypes\",\n        \"ec2:DescribeInstanceCreditSpecifications\",\n        \"ec2:DescribeVolumes\",\n        \"ec2:DescribeAddresses\",\n        \"ec2:DescribeAddressesAttribute\",\n        \"ec2:DescribeSecurityGroupRules\"\n      ],\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CreateTaggedCreateSecurityGroup\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:CreateSecurityGroup\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:security-group/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:RequestTag/Project\": \"fds-hybrid\",\n          \"aws:RequestTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CreateTaggedRunInstances\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:RunInstances\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:instance/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:RequestTag/Project\": \"fds-hybrid\",\n          \"aws:RequestTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CreateTaggedAllocateAddress\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:AllocateAddress\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:elastic-ip/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:RequestTag/Project\": \"fds-hybrid\",\n          \"aws:RequestTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"DenyRunOtherThanT3Medium\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"ec2:RunInstances\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:instance/*\",\n      \"Condition\": {\n        \"StringNotEquals\": {\n          \"ec2:InstanceType\": \"t3.medium\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"DenyRunWithoutImdsv2\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"ec2:RunInstances\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:instance/*\",\n      \"Condition\": {\n        \"StringNotEquals\": {\n          \"ec2:MetadataHttpTokens\": \"required\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"DenyImdsV1Downgrade\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"ec2:ModifyInstanceMetadataOptions\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:instance/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"ec2:MetadataHttpTokens\": \"optional\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"RunWithEncryptedGp3UpTo40GiB\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:RunInstances\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:volume/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"ec2:VolumeType\": \"gp3\"\n        },\n        \"Bool\": {\n          \"ec2:Encrypted\": \"true\"\n        },\n        \"NumericLessThanEquals\": {\n          \"ec2:VolumeSize\": \"40\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"RunWithExactAdoptedAmi\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:RunInstances\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2::image/ami-08d855918a18d0cf9\"\n    },\n    {\n      \"Sid\": \"RunCreatesPrimaryEni\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:RunInstances\",\n        \"ec2:AssociateAddress\",\n        \"ec2:DisassociateAddress\"\n      ],\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:network-interface/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"UseOwnedVpcSubnetSgAsParent\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:CreateSecurityGroup\",\n        \"ec2:RunInstances\"\n      ],\n      \"Resource\": [\n        \"arn:aws:ec2:ap-northeast-2:774055931866:vpc/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:subnet/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:security-group/*\"\n      ],\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:ResourceTag/Project\": \"fds-hybrid\",\n          \"aws:ResourceTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"TagOnlyAtCreate\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:CreateTags\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:*/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"ec2:CreateAction\": [\n            \"CreateSecurityGroup\",\n            \"RunInstances\",\n            \"AllocateAddress\",\n            \"AuthorizeSecurityGroupIngress\",\n            \"AuthorizeSecurityGroupEgress\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"MutateOwnedRelayResources\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:AuthorizeSecurityGroupIngress\",\n        \"ec2:AuthorizeSecurityGroupEgress\",\n        \"ec2:RevokeSecurityGroupIngress\",\n        \"ec2:RevokeSecurityGroupEgress\",\n        \"ec2:ModifySecurityGroupRules\",\n        \"ec2:DeleteSecurityGroup\",\n        \"ec2:ModifyInstanceAttribute\",\n        \"ec2:ModifyInstanceCreditSpecification\",\n        \"ec2:ModifyInstanceMetadataOptions\",\n        \"ec2:StartInstances\",\n        \"ec2:StopInstances\",\n        \"ec2:TerminateInstances\",\n        \"ec2:AssociateAddress\",\n        \"ec2:DisassociateAddress\",\n        \"ec2:ReleaseAddress\",\n        \"ec2:CreateRoute\",\n        \"ec2:ReplaceRoute\",\n        \"ec2:DeleteRoute\",\n        \"ec2:CreateTags\",\n        \"ec2:DeleteTags\"\n      ],\n      \"Resource\": [\n        \"arn:aws:ec2:ap-northeast-2:774055931866:security-group/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:instance/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:elastic-ip/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:route-table/*\"\n      ],\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:ResourceTag/Project\": \"fds-hybrid\",\n          \"aws:ResourceTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"SgRulesUnderOwnedSg\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:AuthorizeSecurityGroupIngress\",\n        \"ec2:AuthorizeSecurityGroupEgress\",\n        \"ec2:RevokeSecurityGroupIngress\",\n        \"ec2:RevokeSecurityGroupEgress\",\n        \"ec2:ModifySecurityGroupRules\"\n      ],\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:security-group-rule/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"TagOwnedSecurityGroupRules\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:CreateTags\",\n        \"ec2:DeleteTags\"\n      ],\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:security-group-rule/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:ResourceTag/Project\": \"fds-hybrid\",\n          \"aws:ResourceTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"ResolveAwsManagedEbsKey\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"kms:DescribeKey\",\n      \"Resource\": \"arn:aws:kms:ap-northeast-2:774055931866:key/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"kms:RequestAlias\": \"alias/aws/ebs\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"SessionDocumentCreateAndReadOnly\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ssm:CreateDocument\",\n        \"ssm:DescribeDocument\",\n        \"ssm:GetDocument\",\n        \"ssm:DescribeDocumentPermission\",\n        \"ssm:ListTagsForResource\",\n        \"ssm:AddTagsToResource\"\n      ],\n      \"Resource\": \"arn:aws:ssm:ap-northeast-2:774055931866:document/SSM-SessionManagerRunShell\"\n    }\n  ]\n}\n",
  "Tags": [
    {
      "Key": "Project",
      "Value": "fds-hybrid"
    },
    {
      "Key": "ManagedBy",
      "Value": "project-bootstrap"
    },
    {
      "Key": "Purpose",
      "Value": "phase2-iac-work-role"
    }
  ]
}