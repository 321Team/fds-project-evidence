{
  "PolicyName": "FDS-IaC-Network",
  "Path": "/",
  "PolicyDocument": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ReadSeoulNetworkMetadata\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:DescribeAvailabilityZones\",\n        \"ec2:DescribeVpcs\",\n        \"ec2:DescribeVpcAttribute\",\n        \"ec2:DescribeSubnets\",\n        \"ec2:DescribeInternetGateways\",\n        \"ec2:DescribeRouteTables\",\n        \"ec2:DescribeNetworkAcls\",\n        \"ec2:DescribeSecurityGroups\",\n        \"ec2:DescribeNetworkInterfaces\",\n        \"ec2:DescribeTags\",\n        \"ec2:DescribeNatGateways\",\n        \"ec2:DescribeAddresses\",\n        \"ec2:DescribeAddressesAttribute\"\n      ],\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CreateTaggedCreateVpc\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:CreateVpc\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:vpc/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:RequestTag/Project\": \"fds-hybrid\",\n          \"aws:RequestTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CreateTaggedCreateInternetGateway\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:CreateInternetGateway\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:internet-gateway/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:RequestTag/Project\": \"fds-hybrid\",\n          \"aws:RequestTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CreateTaggedCreateRouteTable\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:CreateRouteTable\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:route-table/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:RequestTag/Project\": \"fds-hybrid\",\n          \"aws:RequestTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CreateTaggedCreateSubnet\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:CreateSubnet\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:subnet/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:RequestTag/Project\": \"fds-hybrid\",\n          \"aws:RequestTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CreateTaggedCreateNatGateway\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:CreateNatGateway\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:natgateway/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:RequestTag/Project\": \"fds-hybrid\",\n          \"aws:RequestTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CreateTaggedAllocateAddress\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:AllocateAddress\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:elastic-ip/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:RequestTag/Project\": \"fds-hybrid\",\n          \"aws:RequestTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"UseOwnedVpcAsParent\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:CreateRouteTable\",\n        \"ec2:CreateSubnet\"\n      ],\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:vpc/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:ResourceTag/Project\": \"fds-hybrid\",\n          \"aws:ResourceTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"UseOwnedSubnetEipForNat\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:CreateNatGateway\",\n      \"Resource\": [\n        \"arn:aws:ec2:ap-northeast-2:774055931866:subnet/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:elastic-ip/*\"\n      ],\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:ResourceTag/Project\": \"fds-hybrid\",\n          \"aws:ResourceTag/ManagedBy\": \"terraform\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"TagOnlyAtCreate\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:CreateTags\",\n      \"Resource\": \"arn:aws:ec2:ap-northeast-2:774055931866:*/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"ec2:CreateAction\": [\n            \"CreateVpc\",\n            \"CreateInternetGateway\",\n            \"CreateRouteTable\",\n            \"CreateSubnet\",\n            \"CreateNatGateway\",\n            \"AllocateAddress\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"MutateOwnedNetworkResources\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:ModifyVpcAttribute\",\n        \"ec2:ModifySubnetAttribute\",\n        \"ec2:AttachInternetGateway\",\n        \"ec2:DetachInternetGateway\",\n        \"ec2:AssociateRouteTable\",\n        \"ec2:ReplaceRouteTableAssociation\",\n        \"ec2:DisassociateRouteTable\",\n        \"ec2:CreateRoute\",\n        \"ec2:ReplaceRoute\",\n        \"ec2:DeleteRoute\",\n        \"ec2:DeleteVpc\",\n        \"ec2:DeleteSubnet\",\n        \"ec2:DeleteInternetGateway\",\n        \"ec2:DeleteRouteTable\",\n        \"ec2:DeleteNatGateway\",\n        \"ec2:ReleaseAddress\",\n        \"ec2:CreateTags\",\n        \"ec2:DeleteTags\"\n      ],\n      \"Resource\": [\n        \"arn:aws:ec2:ap-northeast-2:774055931866:vpc/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:subnet/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:internet-gateway/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:route-table/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:natgateway/*\",\n        \"arn:aws:ec2:ap-northeast-2:774055931866:elastic-ip/*\"\n      ],\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\",\n          \"aws:ResourceTag/Project\": \"fds-hybrid\",\n          \"aws:ResourceTag/ManagedBy\": \"terraform\"\n        }\n      }\n    }\n  ]\n}\n",
  "Tags": [
    {
      "Key": "Project",
      "Value": "fds-hybrid"
    },
    {
      "Key": "ManagedBy",
      "Value": "project-bootstrap"
    },
    {
      "Key": "Purpose",
      "Value": "phase2-iac-work-role"
    }
  ]
}