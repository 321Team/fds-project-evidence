{
  "PolicyName": "FDS-IaC-State-PassRole",
  "Path": "/",
  "PolicyDocument": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ReadBackendLocation\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:GetBucketLocation\",\n      \"Resource\": \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2\",\n      \"Condition\": {\n        \"ArnEquals\": {\n          \"aws:PrincipalArn\": \"arn:aws:iam::774055931866:role/FDS-IaC-Operator\"\n        },\n        \"Bool\": {\n          \"aws:SecureTransport\": \"true\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"ListBackendPrefixes\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:ListBucket\",\n      \"Resource\": \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2\",\n      \"Condition\": {\n        \"ArnEquals\": {\n          \"aws:PrincipalArn\": \"arn:aws:iam::774055931866:role/FDS-IaC-Operator\"\n        },\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\"\n        },\n        \"Bool\": {\n          \"aws:SecureTransport\": \"true\"\n        },\n        \"StringLike\": {\n          \"s3:prefix\": [\n            \"phase2/*\",\n            \"env:/\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"ReadWriteExactStates\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:GetObject\",\n        \"s3:PutObject\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/network/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/vpn/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-prereq/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-runtime/terraform.tfstate\"\n      ],\n      \"Condition\": {\n        \"ArnEquals\": {\n          \"aws:PrincipalArn\": \"arn:aws:iam::774055931866:role/FDS-IaC-Operator\"\n        },\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\"\n        },\n        \"Bool\": {\n          \"aws:SecureTransport\": \"true\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"ReadWriteDeleteExactLocks\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:GetObject\",\n        \"s3:PutObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/network/terraform.tfstate.tflock\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/vpn/terraform.tfstate.tflock\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-prereq/terraform.tfstate.tflock\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-runtime/terraform.tfstate.tflock\"\n      ],\n      \"Condition\": {\n        \"ArnEquals\": {\n          \"aws:PrincipalArn\": \"arn:aws:iam::774055931866:role/FDS-IaC-Operator\"\n        },\n        \"StringEquals\": {\n          \"aws:RequestedRegion\": \"ap-northeast-2\"\n        },\n        \"Bool\": {\n          \"aws:SecureTransport\": \"true\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"ReadApprovedRelayRole\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:GetRole\",\n      \"Resource\": \"arn:aws:iam::774055931866:role/FDS-Relay-SSM\",\n      \"Condition\": {\n        \"ArnEquals\": {\n          \"aws:PrincipalArn\": \"arn:aws:iam::774055931866:role/FDS-IaC-Operator\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"ReadApprovedRelayProfile\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:GetInstanceProfile\",\n      \"Resource\": \"arn:aws:iam::774055931866:instance-profile/FDS-Relay-SSM\",\n      \"Condition\": {\n        \"ArnEquals\": {\n          \"aws:PrincipalArn\": \"arn:aws:iam::774055931866:role/FDS-IaC-Operator\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"PassApprovedRelayToEC2\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:PassRole\",\n      \"Resource\": \"arn:aws:iam::774055931866:role/FDS-Relay-SSM\",\n      \"Condition\": {\n        \"ArnEquals\": {\n          \"aws:PrincipalArn\": \"arn:aws:iam::774055931866:role/FDS-IaC-Operator\"\n        },\n        \"StringEquals\": {\n          \"iam:PassedToService\": \"ec2.amazonaws.com\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"DenyStateDeletion\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"s3:DeleteObject\",\n      \"Resource\": [\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/network/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/vpn/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-prereq/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-runtime/terraform.tfstate\"\n      ]\n    },\n    {\n      \"Sid\": \"DenyVersionDeletion\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"s3:DeleteObjectVersion\",\n      \"Resource\": [\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/network/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/vpn/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-prereq/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-runtime/terraform.tfstate\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/network/terraform.tfstate.tflock\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/vpn/terraform.tfstate.tflock\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-prereq/terraform.tfstate.tflock\",\n        \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/rosa-runtime/terraform.tfstate.tflock\"\n      ]\n    },\n    {\n      \"Sid\": \"DenyProtectedBucketNonRead\",\n      \"Effect\": \"Deny\",\n      \"NotAction\": [\n        \"s3:Get*\",\n        \"s3:List*\"\n      ],\n      \"Resource\": \"arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2\"\n    },\n    {\n      \"Sid\": \"DenyProtectedRelayIdentityMutation\",\n      \"Effect\": \"Deny\",\n      \"NotAction\": [\n        \"iam:Get*\",\n        \"iam:List*\",\n        \"iam:PassRole\"\n      ],\n      \"Resource\": [\n        \"arn:aws:iam::774055931866:role/FDS-Relay-SSM\",\n        \"arn:aws:iam::774055931866:instance-profile/FDS-Relay-SSM\"\n      ]\n    }\n  ]\n}\n",
